# Copy to .env for normal local-account mode. Never commit .env.
LAB_HOST=127.0.0.1
LAB_PORT=4310
LAB_ORIGIN=http://127.0.0.1:4310
LAB_AUTH_MODE=local
LAB_DATA_DIR=.data/local
# Optional: fixed first-admin setup code. Otherwise generated and printed at startup.
# LAB_SETUP_TOKEN=
# HTTPS demo hosting only: SHA-256 hex of "demo:<random shared password>".
# LAB_DEMO_GATE_HASH=
# Optional GPU source. Only the server connects; no upstream URL is accepted from clients.
# On this server the existing GPU service listens on loopback port 8800.
# GPU measurements use /api/state only; history and occupancy are stored by Lab Chat.
# Optional legacy API billing source (separate from CLI subscription quotas).
# LAB_GPU_URL=http://127.0.0.1:8800

# Current ERP CLI quotas: server-only session JSON {origin, cookie}, mode 0600.
# Never commit the session or expose it to browser code. ERP renews this session on reads.
# LAB_ERP_SESSION_FILE=.data/integrations/erp-session.json
# LAB_AI_USAGE_URL=http://127.0.0.1:8800

# Server inventory: fixed local/SSH targets configured by the operator, never by browser input.
# LAB_SERVER_TARGETS_FILE=.data/integrations/server-targets.json
# Optional backend-only Codex analysis. Existing login use requires the account owner's authorization.
# LAB_INCIDENT_CODEX_ENABLED=1
# LAB_INCIDENT_CODEX_PATH=/absolute/path/to/codex
# LAB_INCIDENT_CODEX_AUTH_FILE=/absolute/path/to/.codex/auth.json
# LAB_INCIDENT_CODEX_MODEL=
