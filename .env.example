# Copy to .env for normal local-account mode. Never commit .env.
LAB_HOST=127.0.0.1
LAB_PORT=4310
LAB_ORIGIN=http://127.0.0.1:4310
LAB_AUTH_MODE=local
LAB_DATA_DIR=.data/local
# Optional: fixed first-admin setup code. Otherwise generated and printed at startup.
# LAB_SETUP_TOKEN=
# HTTPS demo hosting only: SHA-256 hex of "demo:<random shared password>".
# LAB_DEMO_GATE_HASH=
# Optional GPU source. Only the server connects; no upstream URL is accepted from clients.
# On this server the existing GPU service listens on loopback port 8800.
# GPU measurements use /api/state only; history and occupancy are stored by Lab Chat.
# Legacy AI quota/cost endpoints still use this address; they are a separate integration.
# LAB_GPU_URL=http://127.0.0.1:8800
