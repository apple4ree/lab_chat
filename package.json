{
  "name": "lab-chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "node --watch server/index.mjs",
    "build": "tsc --noEmit && vite build && npm run audit:size",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "demo": "LAB_AUTH_MODE=demo LAB_DATA_DIR=.data/demo node server/index.mjs",
    "test": "node --test test/*.test.mjs",
    "test:browser": "playwright test",
    "backup": "node scripts/backup.mjs",
    "audit:size": "node scripts/audit-size.mjs",
    "audit:storage": "node scripts/audit-size.mjs --storage",
    "measure:network": "node scripts/measure-network.mjs"
  },
  "dependencies": {
    "express": "5.3.0",
    "helmet": "8.3.0",
    "lucide-react": "1.59.0",
    "multer": "2.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
